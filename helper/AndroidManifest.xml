<!-- The "other app" of the IchthysProbe clipboard checks. No permissions, no launcher activity
     (so Guard doesn't quarantine it). Its receiver only copies a fixed-prefix test clip and
     answers whether it could read a given test token back; it never returns clip content. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.ichthys.probe.helper"
    android:versionCode="1"
    android:versionName="1.0">

    <application
        android:label="IchthysProbe helper"
        android:allowBackup="false"
        android:hasCode="true">
        <receiver
            android:name=".ClipReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.ichthys.probe.helper.COPY" />
                <action android:name="org.ichthys.probe.helper.READ" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
